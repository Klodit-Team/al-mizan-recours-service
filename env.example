# ─────────────────────────────────────────────
# Al-Mizan – Recours Service – Environment Variables
# Copier ce fichier : cp .env.example .env
# NE JAMAIS commiter le fichier .env sur Git
# ─────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=8008
API_PREFIX=api/v1

# PostgreSQL – choix : Neon (cloud) OU Docker local
# Option A – Neon :
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/recours_db?sslmode=require"
# Option B – Docker local :
# DATABASE_URL="postgresql://recours_user:recours_password@localhost:5436/recours_db"

# PostgreSQL Docker (utilisé par le service postgres dans docker-compose)
POSTGRES_DB=recours_db
POSTGRES_USER=recours_user
POSTGRES_PASSWORD=recours_password

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_RECOURS_QUEUE=recours_queue
RABBITMQ_EXCHANGE=al_mizan_events
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# pgAdmin (optionnel)
PGADMIN_EMAIL=admin@almizan.dz
PGADMIN_PASSWORD=admin123

# Swagger
SWAGGER_TITLE=Al-Mizan – Service Recours
SWAGGER_DESCRIPTION=Microservice de gestion des recours – Loi 23-12, Art. 82-84
SWAGGER_VERSION=1.0
